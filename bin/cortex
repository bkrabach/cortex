#!/usr/bin/env bash
# cortex -- operate the Cortex stack.
#
#   cortex status      ports, pids, health, one screen
#   cortex doctor      check everything; every failure names its remedy
#   cortex logs [svc]  tail the logs  (gateway | drumbeat | hub; -f to follow)
#   cortex start       start services in tmux session 'cortex'
#   cortex stop        drain and stop them
#   cortex restart     stop, then start
#   cortex pair [tag]  mint a single-use pairing code for the phone
#   cortex url         print the pairing URL
#
# Safety rules this script will not break (CONTRACT-PINS.md law 3):
#   - It only ever creates, inspects or kills the tmux session named 'cortex'.
#   - It never binds or signals anything on ports 8443 9443 9000 9100 8088,
#     which belong to other live services on this host.
#
set -uo pipefail

CORTEX_CONF="${HOME}/.config/cortex"
CORTEX_STATE="${HOME}/.local/state/cortex"
CORTEX_SHARE="${HOME}/.local/share/cortex"

GATEWAY_CONF="${CORTEX_CONF}/gateway"
GATEWAY_HOME="${CORTEX_SHARE}/gateway"
DRUMBEAT_WS="${CORTEX_STATE}/drumbeat"
DRUMBEAT_HOME="${CORTEX_SHARE}/drumbeat"
MIND_HOME="${CORTEX_SHARE}/mind"
PACK_HOME="${CORTEX_SHARE}/packs/tmux-kit"
HUB_HOME="${CORTEX_SHARE}/hub"
DIST_DIR="${CORTEX_SHARE}/dist"
LOG_DIR="${CORTEX_STATE}/logs"
OPENAI_KEY_FILE="${GATEWAY_CONF}/openai_key"
GATEWAY_CONFIG_JSON="${GATEWAY_CONF}/config.json"

GATEWAY_PORT=7443
DRUMBEAT_PORT=9102
HUB_PORT=7080
TMUX_SESSION="cortex"
FORBIDDEN_PORTS="8443 9443 9000 9100 8088"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_B=""; C_0=""
fi

FAILS=0; WARNS=0
pass() { printf '%sPASS%s  %-22s %s\n' "$C_OK"   "$C_0" "$1" "${2:-}"; }
warn() { printf '%sWARN%s  %-22s %s\n' "$C_WARN" "$C_0" "$1" "${2:-}"; WARNS=$((WARNS+1)); }
fail() { printf '%sFAIL%s  %-22s %s\n' "$C_ERR"  "$C_0" "$1" "${2:-}"; FAILS=$((FAILS+1)); }
note() { printf '      %s%s%s\n' "$C_DIM" "$*" "$C_0"; }
head_() { printf '\n%s%s%s\n' "$C_B" "$*" "$C_0"; }

# --------------------------------------------------------------- primitives
port_pid() {  # pid holding a listening tcp port, or empty
  local p="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnpH "sport = :${p}" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
  elif command -v lsof >/dev/null 2>&1; then
    lsof -tiTCP:"${p}" -sTCP:LISTEN 2>/dev/null | head -1
  fi
}
port_open() {  # is anything accepting on this port
  python3 - "$1" <<'PY' 2>/dev/null
import socket, sys
s = socket.socket(); s.settimeout(1.0)
sys.exit(0 if s.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)
PY
}
http_code() {  # always exactly one 3-digit code, never a concatenation
  local c; c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$1" 2>/dev/null)
  case "$c" in ''|*[!0-9]*) echo 000 ;; *) echo "$c" ;; esac
}
# Find a CA to verify the gateway with. Prints "<path> disk" or "<path> tofu".
# Never uses curl -k: an unverified check would prove nothing about TLS, and the
# device contract forbids it in clients.
GATEWAY_CA_ORIGIN=""
gateway_ca() {
  local ca
  for ca in "${GATEWAY_CONF}/tls/ca.pem" "${GATEWAY_CONF}/ca.pem" "${CORTEX_STATE}/gateway/tls/ca.pem"; do
    if [ -f "$ca" ]; then GATEWAY_CA_ORIGIN="disk"; echo "$ca"; return 0; fi
  done
  # The gateway publishes its CA unauthenticated at GET /api/ca (CONTRACT.md).
  # Fetching it from the endpoint it secures is trust-on-first-use, not proof --
  # so it is labelled that way everywhere it is reported.
  local tofu="${CORTEX_STATE}/gateway/ca-tofu.pem"
  mkdir -p "$(dirname "$tofu")" 2>/dev/null
  if python3 - "$GATEWAY_PORT" "$tofu" <<'PYCA' 2>/dev/null
import ssl, sys, urllib.request
port, out = sys.argv[1], sys.argv[2]
ctx = ssl._create_unverified_context()
with urllib.request.urlopen(f"https://127.0.0.1:{port}/api/ca", context=ctx, timeout=5) as r:
    data = r.read()
if b"BEGIN CERTIFICATE" not in data:
    sys.exit(1)
with open(out, "wb") as f:
    f.write(data)
PYCA
  then GATEWAY_CA_ORIGIN="tofu"; echo "$tofu"; return 0; fi
  GATEWAY_CA_ORIGIN=""; return 1
}
https_code() {
  local url="$1" ca
  if ca=$(gateway_ca); then
    local c; c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --cacert "$ca" "$url" 2>/dev/null)
    case "$c" in ''|*[!0-9]*) echo 000 ;; *) echo "$c" ;; esac
  else
    echo "NOCA"
  fi
}
cfg_get() {  # print one key from the gateway config, or fail if absent/unreadable
  python3 - "$GATEWAY_CONFIG_JSON" "$1" <<'PYCFG' 2>/dev/null
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(1)
if not isinstance(cfg, dict):
    sys.exit(1)
v = cfg.get(sys.argv[2])
if v is None or v == "":
    sys.exit(1)
print(v)
PYCFG
}
session_exists() { tmux has-session -t "=${TMUX_SESSION}" 2>/dev/null; }
gateway_bin() {
  local c
  for c in cortex-gateway gateway cortexgateway; do
    [ -x "${GATEWAY_HOME}/venv/bin/${c}" ] && { echo "${GATEWAY_HOME}/venv/bin/${c}"; return 0; }
  done
  return 1
}
lan_ip() { ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}' || echo 127.0.0.1; }

guard_forbidden() {  # never let a Cortex port collide with a protected service
  local p
  for p in $FORBIDDEN_PORTS; do
    if [ "$p" = "$GATEWAY_PORT" ] || [ "$p" = "$DRUMBEAT_PORT" ] || [ "$p" = "$HUB_PORT" ]; then
      printf '%serror:%s Cortex is configured to use port %s, which belongs to another live service. Refusing to start.\n' "$C_ERR" "$C_0" "$p" >&2
      exit 1
    fi
  done
}

# ------------------------------------------------------------------- doctor
cmd_doctor() {
  printf '%sCortex doctor%s  %s\n' "$C_B" "$C_0" "$(date -Is)"

  head_ "Prerequisites"
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(0 if sys.version_info>=(3,11) else 1)' 2>/dev/null; then
    pass python3 "$(python3 -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])')"
  else
    fail python3 "need >= 3.11"; note "remedy: sudo apt install python3.11"
  fi
  for c in uv git tmux curl; do
    if command -v "$c" >/dev/null 2>&1; then pass "$c" "$(command -v "$c")"
    else fail "$c" "not found"; note "remedy: install $c and re-run 'cortex doctor'"; fi
  done

  head_ "Components"
  if gb=$(gateway_bin); then pass gateway "$gb"
  else
    fail gateway "not installed"
    note "remedy: the gateway lane's checkout must exist, then re-run install.sh"
    note "        (CORTEX_GATEWAY_SRC=/path/to/cortex-gateway ./install.sh)"
  fi
  if [ -x "${DRUMBEAT_HOME}/venv/bin/drumbeat" ]; then pass drumbeat "${DRUMBEAT_HOME}/venv/bin/drumbeat"
  else fail drumbeat "not installed"; note "remedy: CORTEX_DRUMBEAT_SRC=~/dev/amplifier-attention-manager/drumbeat ./install.sh"; fi
  if [ -f "${HUB_HOME}/serve.py" ]; then pass hub "${HUB_HOME}/serve.py"
  else fail hub "not installed"; note "remedy: re-run install.sh"; fi
  if [ -d "$MIND_HOME" ] && [ -n "$(ls -A "$MIND_HOME" 2>/dev/null)" ]; then pass mind "$MIND_HOME"
  else fail mind "not installed"; note "remedy: CORTEX_MIND_SRC=/path/to/cortex-mind ./install.sh"; fi
  if [ -f "${PACK_HOME}/pack.md" ]; then pass pack "$PACK_HOME"
  else fail pack "not installed"; note "remedy: CORTEX_PACK_SRC=/path/to/cortex-pack-tmux-kit ./install.sh"; fi

  head_ "Configuration"
  if [ -s "$OPENAI_KEY_FILE" ]; then
    local mode; mode=$(stat -c '%a' "$OPENAI_KEY_FILE" 2>/dev/null || echo '?')
    if [ "$mode" = "600" ]; then pass "openai key" "${OPENAI_KEY_FILE} (0600)"
    else warn "openai key" "mode ${mode}, want 0600"; note "remedy: chmod 600 ${OPENAI_KEY_FILE}"; fi
  else
    warn "openai key" "absent -- voice minting will 503 (by design, naming the remedy)"
    note "remedy: printf '%s' sk-... > ${OPENAI_KEY_FILE} && chmod 600 ${OPENAI_KEY_FILE}"
    note "        read per-request: no restart needed once the file exists"
  fi
  if [ -d "$GATEWAY_CONF" ]; then pass "gateway config" "$GATEWAY_CONF"
  else fail "gateway config" "missing"; note "remedy: re-run install.sh"; fi

  # Replies with no default automation slug do not fail -- they fall through and
  # answer nothing, which is exactly the silent lesser state law 1 forbids.
  local slug fleet
  if slug=$(cfg_get reply_default_automation_slug); then
    pass "reply slug" "reply_default_automation_slug=${slug}"
  elif [ -f "$GATEWAY_CONFIG_JSON" ]; then
    fail "reply slug" "reply_default_automation_slug not set in ${GATEWAY_CONFIG_JSON}"
    note "remedy: re-run install.sh (it merges the key in without touching your other values)"
    note "        without it, an inbound reply matches no automation and answers nothing"
  else
    fail "reply slug" "no gateway config at ${GATEWAY_CONFIG_JSON}"
    note "remedy: run the gateway's setup, then re-run install.sh"
  fi

  # fleet_bin is executed by the gateway's fleet_status tool. A configured path
  # that is not there is worse than an absent key: it looks configured.
  if fleet=$(cfg_get fleet_bin); then
    # The config may hold a literal ~ (the gateway's own setup writes one, and
    # expands it at use). Judging the unexpanded string would fail a path that
    # actually works.
    local fleet_r; fleet_r="${fleet/#\~/$HOME}"
    local shown="$fleet"; [ "$fleet_r" != "$fleet" ] && shown="${fleet} -> ${fleet_r}"
    if [ -x "$fleet_r" ]; then
      pass "fleet_bin" "${shown} (executable)"
    elif [ -e "$fleet_r" ]; then
      fail "fleet_bin" "${shown} exists but is not executable"
      note "remedy: chmod +x ${fleet_r}"
    else
      fail "fleet_bin" "${shown} does not exist"
      if [ -x "${PACK_HOME}/bin/tmux-fleet" ]; then
        note "the installed pack DOES have one at ${PACK_HOME}/bin/tmux-fleet -- the"
        note "configured path points somewhere else (a dev workspace, most likely)."
        note "remedy: re-run install.sh; it repoints a fleet_bin that does not resolve"
      else
        note "remedy: install the tmux-kit pack (CORTEX_PACK_SRC=... ./install.sh), then re-run doctor"
      fi
    fi
  elif [ -f "$GATEWAY_CONFIG_JSON" ]; then
    fail "fleet_bin" "fleet_bin not set in ${GATEWAY_CONFIG_JSON}"
    note "remedy: install the tmux-kit pack, then re-run install.sh -- it writes the key"
    note "        only when the binary is really there, so an unset key means it was not"
  else
    fail "fleet_bin" "no gateway config at ${GATEWAY_CONFIG_JSON}"
    note "remedy: run the gateway's setup, then re-run install.sh"
  fi
  # mind_dir is where the gateway reads the persona and instructions from. When
  # it does not resolve, the gateway does NOT fail -- it renders a builtin
  # fallback and reports the check as non-required. That is a silent downgrade
  # of Cortex's whole character, so it is a FAIL here, not a warning.
  if mind=$(cfg_get mind_dir); then
    local mind_r; mind_r="${mind/#\~/$HOME}"
    local mshown="$mind"; [ "$mind_r" != "$mind" ] && mshown="${mind} -> ${mind_r}"
    if [ -d "$mind_r" ]; then
      pass "mind_dir" "${mshown}"
    else
      fail "mind_dir" "${mshown} does not exist -- the gateway falls back to its builtin persona"
      if [ -d "$MIND_HOME" ]; then
        note "the installed mind IS present at ${MIND_HOME} -- the configured path"
        note "points somewhere else (a dev workspace, most likely)."
        note "remedy: re-run install.sh; it repoints a mind_dir that does not resolve"
      else
        note "remedy: install cortex-mind (CORTEX_MIND_SRC=... ./install.sh), then re-run doctor"
      fi
    fi
  elif [ -f "$GATEWAY_CONFIG_JSON" ]; then
    fail "mind_dir" "mind_dir not set in ${GATEWAY_CONFIG_JSON}"
    note "remedy: install cortex-mind, then re-run install.sh -- it writes the key"
    note "        only when the directory is really there, so an unset key means it was not"
  fi

  if [ -d "${DRUMBEAT_WS}/automations" ]; then
    pass "drumbeat workspace" "$DRUMBEAT_WS"
  else
    fail "drumbeat workspace" "no automations/ -- drumbeat will refuse to start"
    note "remedy: install cortex-mind (it supplies automations/), then re-run install.sh"
    note "        an empty automations/ is NOT created on purpose: it would schedule"
    note "        nothing while looking healthy"
  fi
  if [ -f "${DRUMBEAT_WS}/packs.txt" ]; then pass "drumbeat packs.txt" "$(grep -cv '^\s*\(#\|$\)' "${DRUMBEAT_WS}/packs.txt" 2>/dev/null || echo 0) pack(s)"
  else fail "drumbeat packs.txt" "missing"; note "remedy: re-run install.sh"; fi

  head_ "Services"
  if session_exists; then
    pass "tmux session" "'${TMUX_SESSION}' ($(tmux list-windows -t "=${TMUX_SESSION}" 2>/dev/null | wc -l) windows)"
  else
    fail "tmux session" "'${TMUX_SESSION}' not running"; note "remedy: cortex start"
  fi

  local code
  code=$(http_code "http://127.0.0.1:${HUB_PORT}/healthz")
  if [ "$code" = "200" ]; then pass "hub :${HUB_PORT}" "healthz 200"
  else fail "hub :${HUB_PORT}" "healthz ${code}"; note "remedy: cortex start; then cortex logs hub"; fi

  code=$(https_code "https://127.0.0.1:${GATEWAY_PORT}/healthz")
  case "$code" in
    200)
      if [ "$GATEWAY_CA_ORIGIN" = "disk" ]; then
        pass "gateway :${GATEWAY_PORT}" "healthz 200, TLS verified against the CA on disk"
      else
        pass "gateway :${GATEWAY_PORT}" "healthz 200, TLS verified against the CA it serves at /api/ca"
        note "that is trust-on-first-use, not independent proof: this check confirms the"
        note "gateway serves a consistent chain, not that the chain is the one you expect."
        note "The phone does the same thing once, at pairing."
      fi;;
    NOCA)
      if port_open "$GATEWAY_PORT"; then
        warn "gateway :${GATEWAY_PORT}" "listening, but served no usable CA (no file on disk, /api/ca gave none)"
        note "remedy: run the gateway's setup so it writes its CA, then re-run doctor"
      else
        fail "gateway :${GATEWAY_PORT}" "not listening"; note "remedy: cortex start; then cortex logs gateway"
      fi;;
    000)  fail "gateway :${GATEWAY_PORT}" "no response"; note "remedy: cortex start; then cortex logs gateway";;
    *)    warn "gateway :${GATEWAY_PORT}" "healthz ${code}"; note "remedy: cortex logs gateway";;
  esac

  code=$(http_code "http://127.0.0.1:${DRUMBEAT_PORT}/api/health")
  case "$code" in
    200) pass "drumbeat :${DRUMBEAT_PORT}" "api/health 200";;
    401|403) pass "drumbeat :${DRUMBEAT_PORT}" "answering (${code}: needs instance api key -- engine is up)";;
    000) fail "drumbeat :${DRUMBEAT_PORT}" "no response"; note "remedy: cortex start; then cortex logs drumbeat";;
    *)   warn "drumbeat :${DRUMBEAT_PORT}" "api/health ${code}"; note "remedy: cortex logs drumbeat";;
  esac

  head_ "Rails"
  # GET /v1/notifications -- the Texting rail the phone polls. doctor holds no
  # paired device credential, so the honest question it CAN answer is whether
  # the rail exists and enforces auth. 404 means the gateway lane has not landed
  # it yet, and this says so instead of passing on a shape it never saw.
  code=$(https_code "https://127.0.0.1:${GATEWAY_PORT}/v1/notifications")
  case "$code" in
    401|403) pass "GET /v1/notifications" "rail present, ${code} unauthenticated (device auth enforced, as contracted)";;
    200)
      warn "GET /v1/notifications" "answered 200 WITHOUT a device credential"
      note "doctor sent no pairing key, so a 200 means this rail is not enforcing device"
      note "auth. remedy: gateway lane -- require the device key on this endpoint";;
    404)
      warn "GET /v1/notifications" "not served by the running gateway yet (404)"
      note "the gateway lane is landing /v1/notifications; this check is not a pass and"
      note "does not pretend to be. remedy: re-run 'cortex doctor' once that lane lands";;
    NOCA)
      warn "GET /v1/notifications" "not checked -- no CA available to verify the gateway"
      note "remedy: run the gateway's setup so it writes its CA, then re-run doctor";;
    000)
      fail "GET /v1/notifications" "gateway did not answer"
      note "remedy: cortex start; then cortex logs gateway";;
    *)  warn "GET /v1/notifications" "unexpected ${code}"; note "remedy: cortex logs gateway";;
  esac

  # The delivery worker's cursor is how we know notifications are actually being
  # consumed off drumbeat's outbox rather than piling up unread.
  local hb
  hb=$(curl -s --max-time 5 "http://127.0.0.1:${DRUMBEAT_PORT}/api/health" 2>/dev/null)
  local verdict
  # The body goes in as argv, NOT on stdin: stdin is already carrying this
  # script. Piping it in gave python an empty read and a check that reported
  # "returned nothing" while curl was plainly returning JSON.
  verdict=$(python3 - "$hb" <<'PYOUT' 2>/dev/null
import json, sys
raw = sys.argv[1].strip()
if not raw:
    print("FAIL|drumbeat /api/health returned nothing|remedy: cortex start; then cortex logs drumbeat")
    sys.exit(0)
try:
    hb = json.loads(raw)
except ValueError:
    print("WARN|drumbeat /api/health is not JSON (needs an instance api key?)|"
          "remedy: read it by hand: curl -s http://127.0.0.1:9102/api/health")
    sys.exit(0)
ob = hb.get("outbox") if isinstance(hb, dict) else None
if not isinstance(ob, dict):
    if isinstance(hb, dict) and (hb.get("detail") or hb.get("error")):
        print(f"WARN|drumbeat refused the health read: {hb.get('detail') or hb.get('error')}|"
              "remedy: this instance wants an api key; read it by hand with that key set")
    else:
        keys = ", ".join(sorted(hb)) if isinstance(hb, dict) else type(hb).__name__
        print(f"WARN|this drumbeat build publishes no outbox section (got: {keys}), "
              "so the cursor cannot be read|"
              "remedy: update the drumbeat checkout, then re-run install.sh")
    sys.exit(0)
cur = ob.get("cursor")
if cur is None:
    reason = ob.get("worker_cursor_source") or "no reason published"
    print(f"WARN|no cursor published: {reason}|"
          "remedy: start the consumer's delivery worker, then re-run doctor")
else:
    lag = ob.get("worker_cursor_lag")
    upd = ob.get("worker_cursor_updated_at") or "unknown"
    halt = ob.get("worker_halt_reason")
    if halt:
        print(f"FAIL|delivery worker halted: {halt}|remedy: cortex logs drumbeat")
    else:
        print(f"PASS|cursor {cur}, lag {lag}, updated {upd}|")
PYOUT
)
  case "${verdict%%|*}" in
    PASS) pass "delivery cursor" "$(printf '%s' "$verdict" | cut -d'|' -f2)";;
    WARN) warn "delivery cursor" "$(printf '%s' "$verdict" | cut -d'|' -f2)"
          note "$(printf '%s' "$verdict" | cut -d'|' -f3)";;
    FAIL) fail "delivery cursor" "$(printf '%s' "$verdict" | cut -d'|' -f2)"
          note "$(printf '%s' "$verdict" | cut -d'|' -f3)";;
    *)    fail "delivery cursor" "could not evaluate drumbeat's outbox section"
          note "remedy: curl -s http://127.0.0.1:${DRUMBEAT_PORT}/api/health and read it by hand";;
  esac

  head_ "Distribution"
  if [ -f "${DIST_DIR}/cortex.apk" ]; then
    pass "android apk" "$(du -h "${DIST_DIR}/cortex.apk" | cut -f1) at ${DIST_DIR}/cortex.apk"
  else
    warn "android apk" "not built yet -- hub serves an honest 404, never a placeholder"
    note "remedy: the android lane drops cortex.apk into ${DIST_DIR}/ (no restart needed)"
  fi

  head_ "Neighbours (must be untouched)"
  local busy=""
  for p in $FORBIDDEN_PORTS; do port_open "$p" && busy="${busy} ${p}"; done
  pass "protected ports" "live:${busy:- none} -- Cortex binds only ${GATEWAY_PORT}/${DRUMBEAT_PORT}/${HUB_PORT}"

  printf '\n'
  if [ "$FAILS" -eq 0 ]; then
    printf '%sdoctor: all checks passed%s' "$C_OK" "$C_0"
    [ "$WARNS" -gt 0 ] && printf ' (%d warning(s) -- named above, none fatal)' "$WARNS"
    printf '\n'; return 0
  fi
  printf '%sdoctor: %d check(s) FAILED%s -- fix the named remedies and re-run\n' "$C_ERR" "$FAILS" "$C_0"
  return 1
}

# ------------------------------------------------------------------- status
cmd_status() {
  printf '%sCortex status%s  %s\n\n' "$C_B" "$C_0" "$(date -Is)"
  printf '%-10s %-7s %-10s %-8s %s\n' SERVICE PORT STATE PID HEALTH
  printf '%-10s %-7s %-10s %-8s %s\n' ------- ---- ----- --- ------
  # State comes from whether the port actually accepts a connection, not from
  # whether we could name a pid. ss and lsof are both absent on a minimal box,
  # and "down" next to "200" is a status line that lies.
  local pid state
  state=$(port_open "$GATEWAY_PORT" && echo up || echo down); pid=$(port_pid "$GATEWAY_PORT")
  printf '%-10s %-7s %-10s %-8s %s\n' gateway "$GATEWAY_PORT" "$state" "${pid:-n/a}" "$(https_code "https://127.0.0.1:${GATEWAY_PORT}/healthz")"
  state=$(port_open "$DRUMBEAT_PORT" && echo up || echo down); pid=$(port_pid "$DRUMBEAT_PORT")
  printf '%-10s %-7s %-10s %-8s %s\n' drumbeat "$DRUMBEAT_PORT" "$state" "${pid:-n/a}" "$(http_code "http://127.0.0.1:${DRUMBEAT_PORT}/api/health")"
  state=$(port_open "$HUB_PORT" && echo up || echo down); pid=$(port_pid "$HUB_PORT")
  printf '%-10s %-7s %-10s %-8s %s\n' hub "$HUB_PORT" "$state" "${pid:-n/a}" "$(http_code "http://127.0.0.1:${HUB_PORT}/healthz")"
  printf '\ntmux session %-8s %s\n' "'${TMUX_SESSION}'" "$(session_exists && echo running || echo 'not running (cortex start)')"
  printf 'pairing url  %s\n' "http://$(lan_ip):${HUB_PORT}/"
  printf 'logs         %s\n' "$LOG_DIR"
}

# -------------------------------------------------------------------- start
start_window() {  # name, command
  local name="$1" cmd="$2" log="${LOG_DIR}/$1.log"
  mkdir -p "$LOG_DIR"
  # tee -a, never plain tee: a restart must append to the log, not truncate it.
  local wrapped="set -o pipefail; echo \"[cortex] starting ${name} at \$(date -Is)\" | tee -a '${log}'; ${cmd} 2>&1 | tee -a '${log}'; rc=\${PIPESTATUS[0]}; echo \"[cortex] ${name} exited rc=\${rc} at \$(date -Is)\" | tee -a '${log}'; echo; echo 'window kept open so the error above is readable. ctrl-d to close.'; exec bash"
  if session_exists; then
    tmux new-window -t "=${TMUX_SESSION}" -n "$name" "bash -lc $(printf '%q' "$wrapped")"
  else
    tmux new-session -d -s "$TMUX_SESSION" -n "$name" "bash -lc $(printf '%q' "$wrapped")"
  fi
}

cmd_start() {
  guard_forbidden
  if session_exists; then
    printf 'tmux session %s already running -- nothing to start.\n' "'${TMUX_SESSION}'"
    printf 'Use "cortex restart" to cycle it, or "cortex status" to see health.\n'
    return 0
  fi
  local started=0 skipped=0
  STARTED_SVCS=""

  # Refuse to start on top of someone else's listener.
  local p
  for p in "$GATEWAY_PORT" "$DRUMBEAT_PORT" "$HUB_PORT"; do
    if port_open "$p"; then
      printf '%serror:%s port %s is already in use by pid %s, and it is not ours.\n' "$C_ERR" "$C_0" "$p" "$(port_pid "$p")" >&2
      printf '  remedy: stop that process, or change the Cortex port. Refusing to start.\n' >&2
      return 1
    fi
  done

  local gb
  if gb=$(gateway_bin); then
    # Ask the gateway what its serve command accepts rather than assuming. It
    # takes its port from the config that `setup` wrote; passing an unrecognised
    # --port kills it on launch.
    local gwargs=""
    if "$gb" serve --help 2>&1 | grep -q -- '--port'; then gwargs=" --port ${GATEWAY_PORT}"; fi
    start_window gateway "'${gb}' serve${gwargs}"
    started=$((started+1)); STARTED_SVCS="${STARTED_SVCS} gateway"
  else
    printf '%sskip%s gateway -- not installed (cortex doctor names the remedy)\n' "$C_WARN" "$C_0"; skipped=$((skipped+1))
  fi

  if [ -x "${DRUMBEAT_HOME}/venv/bin/drumbeat" ]; then
    if [ -d "${DRUMBEAT_WS}/automations" ]; then
      # 'cortex stop' drains the scheduler via a flag file that SURVIVES restarts.
      # Starting without clearing it leaves the engine permanently drained
      # (registered={}, runs never start) -- a silent lesser state (law 1).
      # Clear it by drumbeat's own procedure; a failed clear is loud, not fatal.
      "${DRUMBEAT_HOME}/venv/bin/drumbeat" drain --clear --workspace "$DRUMBEAT_WS" >/dev/null 2>&1 \
        || printf '%swarn%s could not clear drumbeat drain flag -- engine may start drained (cortex logs drumbeat)\n' "$C_WARN" "$C_0"
      start_window drumbeat "'${DRUMBEAT_HOME}/venv/bin/drumbeat' serve --workspace '${DRUMBEAT_WS}' --port ${DRUMBEAT_PORT}"
      started=$((started+1)); STARTED_SVCS="${STARTED_SVCS} drumbeat"
    else
      printf '%sskip%s drumbeat -- workspace has no automations/; the engine would refuse to start anyway\n' "$C_WARN" "$C_0"
      skipped=$((skipped+1))
    fi
  else
    printf '%sskip%s drumbeat -- not installed\n' "$C_WARN" "$C_0"; skipped=$((skipped+1))
  fi

  if [ -f "${HUB_HOME}/serve.py" ]; then
    local hubpy="python3"
    [ -x "${HUB_HOME}/venv/bin/python" ] && hubpy="${HUB_HOME}/venv/bin/python"
    start_window hub "'${hubpy}' '${HUB_HOME}/serve.py' --port ${HUB_PORT} --dist-dir '${DIST_DIR}' --gateway-port ${GATEWAY_PORT}"
    started=$((started+1)); STARTED_SVCS="${STARTED_SVCS} hub"
  else
    printf '%sskip%s hub -- not installed\n' "$C_WARN" "$C_0"; skipped=$((skipped+1))
  fi

  if [ "$started" -eq 0 ]; then
    printf '%serror:%s nothing to start -- no components are installed. Run install.sh.\n' "$C_ERR" "$C_0" >&2
    return 1
  fi

  # Launching a tmux window is not the same as a service coming up. Wait for each
  # one to actually accept a connection before claiming anything: a service that
  # crashes 200ms after launch must never be reported as started.
  local up=0 dead=0 svc port waited
  for svc in $STARTED_SVCS; do
    case "$svc" in
      gateway)  port=$GATEWAY_PORT ;;
      drumbeat) port=$DRUMBEAT_PORT ;;
      hub)      port=$HUB_PORT ;;
      *) continue ;;
    esac
    waited=0
    while [ "$waited" -lt 15 ]; do
      port_open "$port" && break
      sleep 1; waited=$((waited+1))
    done
    if port_open "$port"; then
      printf '%sup%s   %-9s :%s\n' "$C_OK" "$C_0" "$svc" "$port"; up=$((up+1))
    else
      printf '%sDEAD%s %-9s :%s did not come up within %ss\n' "$C_ERR" "$C_0" "$svc" "$port" "$waited"
      printf '     last words: %s\n' "$(grep -v '^\[cortex\]' "${LOG_DIR}/${svc}.log" 2>/dev/null | tail -1 | cut -c1-140)"
      printf '     remedy: cortex logs %s   (its tmux window is kept open with the full trace)\n' "$svc"
      dead=$((dead+1))
    fi
  done

  printf '\n%d up' "$up"
  [ "$dead" -gt 0 ]    && printf ', %s%d dead%s' "$C_ERR" "$dead" "$C_0"
  [ "$skipped" -gt 0 ] && printf ', %d skipped (not installed)' "$skipped"
  printf '\n'
  printf 'attach with: tmux attach -t %s\n' "$TMUX_SESSION"
  [ "$dead" -gt 0 ] && return 1
  return 0
}

# --------------------------------------------------------------------- stop
cmd_stop() {
  if ! session_exists; then printf 'tmux session %s is not running.\n' "'${TMUX_SESSION}'"; return 0; fi
  # Drain drumbeat first, by its own procedure -- never pkill -f, never a blind kill.
  if [ -x "${DRUMBEAT_HOME}/venv/bin/drumbeat" ] && port_open "$DRUMBEAT_PORT"; then
    printf 'draining drumbeat...\n'
    "${DRUMBEAT_HOME}/venv/bin/drumbeat" drain --workspace "$DRUMBEAT_WS" \
      --reason 'cortex stop' --wait --timeout 120 2>&1 | sed 's/^/  /' || \
      printf '  drain did not complete cleanly -- continuing to stop (see cortex logs drumbeat)\n'
  fi
  tmux kill-session -t "=${TMUX_SESSION}" 2>/dev/null && printf 'stopped tmux session %s\n' "'${TMUX_SESSION}'"
}

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

# --------------------------------------------------------------------- logs
cmd_logs() {
  local svc="${1:-}" follow=""
  [ "$svc" = "-f" ] && { follow="-f"; svc=""; }
  [ "${2:-}" = "-f" ] && follow="-f"
  mkdir -p "$LOG_DIR"
  local files
  if [ -n "$svc" ]; then
    case "$svc" in
      gateway|drumbeat|hub) files="${LOG_DIR}/${svc}.log" ;;
      *) printf 'unknown service %s -- expected: gateway | drumbeat | hub\n' "'$svc'" >&2; return 1 ;;
    esac
    [ -f "$files" ] || { printf 'no log yet at %s (has it started? cortex status)\n' "$files"; return 1; }
  else
    files=$(ls "${LOG_DIR}"/*.log 2>/dev/null)
    [ -n "$files" ] || { printf 'no logs yet in %s (cortex start)\n' "$LOG_DIR"; return 1; }
  fi
  # shellcheck disable=SC2086
  tail -n 100 $follow $files
}

# --------------------------------------------------------------------- pair
# Minting lives in the gateway, which owns the pairing rail. This is a thin
# front door onto `cortex-gateway pair` so a terminal user never has to know
# where the gateway venv landed. It prints a code or it fails loudly -- it
# never synthesises one, because a code the gateway has not recorded cannot be
# redeemed by the gateway that has to honour it.
cmd_pair() {
  local label="${1:-terminal}" gb out rc
  if ! gb=$(gateway_bin); then
    printf '%serror:%s the cortex-gateway CLI is not installed at %s\n' "$C_ERR" "$C_0" "${GATEWAY_HOME}/venv/bin/" >&2
    printf '  remedy: run install.sh, then re-run "cortex doctor"\n' >&2
    return 1
  fi
  out=$("$gb" pair --label "$label" 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%serror:%s cortex-gateway pair exited %s\n' "$C_ERR" "$C_0" "$rc" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    printf '  remedy: if the gateway is unconfigured, run "%s setup"; then "cortex doctor"\n' "$gb" >&2
    return 1
  fi

  local code expires
  code=$(printf '%s\n' "$out" | grep -oE '[0-9a-f]{4}-[0-9a-f]{4}' | head -1)
  expires=$(printf '%s\n' "$out" | sed -n 's/^expires:[[:space:]]*//p' | head -1)
  if [ -z "$code" ]; then
    printf '%serror:%s cortex-gateway pair succeeded but printed no recognisable code:\n' "$C_ERR" "$C_0" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    return 1
  fi

  printf '\n  %spairing code%s   %s%s%s\n' "$C_DIM" "$C_0" "$C_B" "$code" "$C_0"
  printf '  %sexpires%s        %s\n' "$C_DIM" "$C_0" "${expires:-unknown}"
  printf '  %ssingle use%s     redeeming it once spends it\n\n' "$C_DIM" "$C_0"
  printf 'On the phone: open Cortex -> Settings, then\n'
  printf '  Gateway URL    %shttps://%s:%s%s\n' "$C_B" "$(lan_ip)" "$GATEWAY_PORT" "$C_0"
  printf '  Pairing code   %s%s%s\n' "$C_B" "$code" "$C_0"
  printf 'and tap Pair. (Full walkthrough: %s)\n' "http://$(lan_ip):${HUB_PORT}/"
}

cmd_url() { printf 'http://%s:%s/\n' "$(lan_ip)" "$HUB_PORT"; }

# Print the comment header, however long it is. A fixed line range silently
# starts leaking source code the moment a command is added to the header.
usage() { awk 'NR<2{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

case "${1:-status}" in
  doctor)  shift; cmd_doctor "$@" ;;
  status)  shift; cmd_status "$@" ;;
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  pair)    shift; cmd_pair "$@" ;;
  url)     shift; cmd_url "$@" ;;
  -h|--help|help) usage ;;
  *) printf 'unknown command: %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
esac
